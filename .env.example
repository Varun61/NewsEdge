# NewsEdge Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# AI Provider Configuration
# =============================================================================
# Options: ollama, openai
AI_PROVIDER=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI Configuration (if using openai provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# Telegram Configuration
# =============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_AUTHORIZED_USERS=user_id_1,user_id_2

# =============================================================================
# Groww Watchlist Sync Configuration
# =============================================================================
# OPTION 1: Manual Bearer / Session Token (expires after 24-48 hours)
# Log into Groww Web -> F12 -> Network -> copy 'Authorization: Bearer <token>'
GROWW_AUTH_TOKEN=your_groww_token_here

# OPTION 2: Permanent Headless Auto-Login (NEVER EXPIRES)
# Script auto-computes fresh 6-digit TOTP code every morning at 7:00 AM using pyotp.
# To get your TOTP Secret: Groww Web -> Profile -> Security -> Enable 2FA/TOTP -> copy Secret Key
GROWW_EMAIL=
GROWW_PASSWORD=
GROWW_TOTP_SECRET=

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=sqlite:///data/newsedge.db

# =============================================================================
# Application Settings
# =============================================================================
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# =============================================================================
# Collection Window
# =============================================================================
# The batch job collects news from previous trading day 15:30 IST
# until current day 07:59 IST, then analyses and sends the report.
COLLECTION_START_HOUR=15
COLLECTION_START_MINUTE=30
COLLECTION_END_HOUR=7
COLLECTION_END_MINUTE=59

# =============================================================================
# Market Data (optional, for future use)
# =============================================================================
MARKET_DATA_PROVIDER=none
